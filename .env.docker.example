# ===========================================================================
# Contoh .env untuk deployment Docker di VPS Ubuntu.
# Salin menjadi .env lalu isi APP_KEY dan VAPID keys.
#   cp .env.docker.example .env
#   docker compose run --rm app php artisan key:generate --show
#   docker compose run --rm app php artisan webpush:vapid --show
# ===========================================================================

APP_NAME="Dashboard Keuangan"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://keuangan.domain-anda.com

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# Port di host VPS. Ubah bila 8080 sudah dipakai aplikasi lain.
# Di dalam container Nginx selalu mendengarkan port 8080.
APP_PORT=8080

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Database (service "db" pada docker-compose) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=keuangan
DB_USERNAME=keuangan
DB_PASSWORD=ganti-password-ini
DB_ROOT_PASSWORD=ganti-root-password-ini

# --- Cache / queue / session ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Web Push (VAPID) ---
VAPID_SUBJECT="mailto:admin@domain-anda.com"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Mail (opsional) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@domain-anda.com"
MAIL_FROM_NAME="${APP_NAME}"
